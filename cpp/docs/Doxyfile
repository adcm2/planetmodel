# The Doxygen reference of planetmodel's C++ library.
#
# Run from cpp/ (the CMake target `planetmodel_docs` and docs/source/conf.py
# both do), with PLANETMODEL_DOCS_OUTPUT naming the directory to write into
# and PLANETMODEL_VERSION the version; the HTML lands in
# $(PLANETMODEL_DOCS_OUTPUT)/cpp-reference.  Every warning fails the build,
# an undocumented public name among them.

PROJECT_NAME           = "planetmodel C++"
PROJECT_NUMBER         = "$(PLANETMODEL_VERSION)"
PROJECT_BRIEF          = "Read and write planetmodel's model files, manifests and decks"
OUTPUT_DIRECTORY       = "$(PLANETMODEL_DOCS_OUTPUT)"
CREATE_SUBDIRS         = NO

INPUT                  = include README.md
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = YES
EXAMPLE_PATH           = examples
USE_MDFILE_AS_MAINPAGE = README.md
STRIP_FROM_PATH        = include
STRIP_FROM_INC_PATH    = include

# The internals of a header are left out of the reference.
EXCLUDE_SYMBOLS        = planetmodel::detail planetmodel::netcdf::detail

OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
BUILTIN_STL_SUPPORT    = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"

GENERATE_HTML          = YES
HTML_OUTPUT            = cpp-reference
GENERATE_TREEVIEW      = YES
USE_MATHJAX            = NO
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
HAVE_DOT               = NO
